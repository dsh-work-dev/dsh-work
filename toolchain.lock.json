{
  "schemaVersion": 1,
  "go": {
    "version": "1.25.14",
    "moduleLanguageVersion": "1.25.0"
  },
  "wails": {
    "cli": "v3.0.0-beta.16",
    "module": "v3.0.0-beta.16",
    "install": "go install github.com/wailsapp/wails/v3/cmd/wails3@v3.0.0-beta.16"
  },
  "nsis": {
    "package": "nsis",
    "version": "3.12.0"
  },
  "node": {
    "minimumMajor": 24
  },
  "packageManager": {
    "name": "npm",
    "version": "11.19.0",
    "lockfile": "frontend/package-lock.json"
  },
  "dsh": {
    "package": "@deepseek-ai/dsh",
    "version": "0.1.7-alpha.2",
    "profile": "web",
    "compatibility": "exact-version"
  },
  "targets": {
    "development": "windows/amd64",
    "validation": ["windows/amd64", "darwin/amd64", "linux/amd64"]
  }
}
